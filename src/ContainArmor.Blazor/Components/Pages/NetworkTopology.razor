@page "/network-topology"
@inject ContainArmorStateService State
@implements IDisposable

<PageTitle>Intra-Bridge Isolation Matrix | ContainArmor</PageTitle>

<div class="network-topology-container">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="m-0 font-weight-bold text-white">Intra-Bridge Isolation & Micro-Segmentation</h2>
                <span class="soc-badge soc-badge-cyan">NETWORK POLICY AUDITOR</span>
            </div>
            <p class="text-secondary small mb-0 mt-1">
                Deep packet routing audit across Docker bridges, inter-container communication (ICC) flags, and netfilter cross-talk policies.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="soc-btn-primary" @onclick="State.TriggerAuditAsync" disabled="@State.IsAuditing">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                <span>Re-evaluate Bridge Rules</span>
            </button>
        </div>
    </div>

    <!-- Bridge Network Selector Tabs -->
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        @foreach (var bridge in State.BridgeAudits)
        {
            <button class="soc-btn-outline @(SelectedBridge?.Id == bridge.Id ? "border-cyan text-cyan bg-dark" : "")"
                    @onclick="@(() => SelectBridge(bridge.Id))">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                </svg>
                <span>@bridge.Name</span>
                <span class="soc-badge @(bridge.EnableIcc ? (bridge.Breaches.Count > 0 ? "soc-badge-critical" : "soc-badge-high") : "soc-badge-secure") ms-1">
                    @(bridge.EnableIcc ? "ICC ENABLED" : "ICC BLOCKED")
                </span>
            </button>
        }
    </div>

    @if (SelectedBridge != null)
    {
        var b = SelectedBridge;
        var attachedProfiles = State.Containers
            .Where(c => c.Networks.Any(n => n.NetworkId == b.Id || n.NetworkName == b.Name))
            .ToList();

        <!-- Bridge Configuration Card -->
        <div class="row g-3 mb-4">
            <div class="col-lg-8">
                <div class="soc-card h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="soc-heading m-0">Bridge: @b.Name</span>
                            <span class="soc-badge soc-badge-neutral font-mono">ID: @b.Id[..Math.Min(12, b.Id.Length)]</span>
                        </div>
                        <span class="soc-badge @(b.EnableIcc ? "soc-badge-high" : "soc-badge-secure")">
                            com.docker.network.bridge.enable_icc = @b.EnableIcc.ToString().ToLowerInvariant()
                        </span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <div class="text-muted small">Subnet CIDR</div>
                            <div class="text-white font-mono font-weight-bold">@(string.IsNullOrEmpty(b.Subnet) ? "172.17.0.0/16" : b.Subnet)</div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Default Gateway</div>
                            <div class="text-white font-mono font-weight-bold">@(string.IsNullOrEmpty(b.Gateway) ? "172.17.0.1" : b.Gateway)</div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Driver</div>
                            <div class="text-white font-mono">@b.Driver.ToUpperInvariant()</div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Attached Workloads</div>
                            <div class="text-cyan font-mono font-weight-bold">@b.ConnectedContainers.Count Containers</div>
                        </div>
                    </div>

                    <div class="p-3 rounded bg-dark bg-opacity-50 border @(b.EnableIcc ? "border-warning border-opacity-25" : "border-success border-opacity-25")">
                        <div class="d-flex align-items-start gap-2">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(b.EnableIcc ? "text-warning" : "text-success") mt-1">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <div>
                                <div class="text-white font-weight-bold small">Bridge Isolation Posture Assessment</div>
                                <div class="text-secondary small mt-1">@b.StatusSummary</div>
                                @if (b.EnableIcc)
                                {
                                    <div class="mt-2 text-warning small font-mono">
                                        THREAT VECTOR: Unsolicited layer-2/layer-3 lateral traffic permitted between all containers on bridge '@b.Name'. An infected container can probe ports, spoof ARP, or sniff cleartext traffic.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bridge Threat Score -->
            <div class="col-lg-4">
                <div class="soc-card h-100 d-flex flex-column justify-content-between @(b.SecurityScore < 60 ? "soc-card-glow-critical" : "")">
                    <div class="soc-heading">Bridge Security Score</div>
                    <div class="text-center my-3">
                        <div class="display-4 font-mono font-weight-bold @(b.SecurityScore >= 80 ? "text-success" : b.SecurityScore >= 60 ? "text-warning" : "text-danger")">
                            @b.SecurityScore<span class="small" style="font-size: 1.5rem;">/100</span>
                        </div>
                        <div class="small text-muted font-mono mt-1">SEVERITY: @b.RiskLevel.ToString().ToUpperInvariant()</div>
                    </div>
                    <div class="d-flex flex-column gap-1 small text-secondary border-top border-secondary pt-2">
                        <div class="d-flex justify-content-between">
                            <span>Detected Lateral Breaches:</span>
                            <span class="font-mono text-danger font-weight-bold">@b.Breaches.Count</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Total Monitored Flows:</span>
                            <span class="font-mono text-white">@b.InterContainerMatrix.Count</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Visual Network Topology SVG Graph -->
        <div class="soc-card mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="soc-heading m-0">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                    Live Intra-Bridge Packet Flow Topology
                </div>
                <div class="d-flex align-items-center gap-2 small">
                    <span class="d-flex align-items-center gap-1 text-danger font-mono"><span style="display:inline-block; width:12px; height:2px; background:#EF4444;"></span> Insecure Flow (Asymmetric)</span>
                    <span class="d-flex align-items-center gap-1 text-warning font-mono"><span style="display:inline-block; width:12px; height:2px; background:#F59E0B;"></span> Unsegmented Bridge</span>
                    <span class="d-flex align-items-center gap-1 text-success font-mono"><span style="display:inline-block; width:12px; height:2px; background:#10B981;"></span> Segmented / Drop Rule</span>
                </div>
            </div>

            <!-- SVG Topology Diagram -->
            <div class="topology-svg-wrapper p-3 bg-dark bg-opacity-75 rounded border border-secondary" style="min-height: 280px; display: flex; align-items: center; justify-content: center;">
                <svg width="100%" height="240" viewBox="0 0 800 240" style="overflow: visible;">
                    <!-- Central Bridge Router Node -->
                    <circle cx="400" cy="120" r="38" fill="#1E293B" stroke="#06B6D4" stroke-width="2.5" />
                    <text x="400" y="115" text-anchor="middle" fill="#06B6D4" font-weight="700" font-size="12" font-family="'JetBrains Mono', monospace">BRIDGE</text>
                    <text x="400" y="132" text-anchor="middle" fill="#94A3B8" font-size="10" font-family="'JetBrains Mono', monospace">@b.Name</text>

                    @{
                        var nodes = attachedProfiles.Take(6).ToList();
                        int count = Math.Max(1, nodes.Count);
                        double radius = 180;
                    }

                    @for (int idx = 0; idx < nodes.Count; idx++)
                    {
                        var profile = nodes[idx];
                        double angle = (2 * Math.PI / count) * idx - (Math.PI / 2);
                        double nx = 400 + radius * Math.Cos(angle);
                        double ny = 120 + (radius * 0.55) * Math.Sin(angle);

                        var isDangerous = profile.RiskLevel >= SeverityLevel.High;
                        var podName = profile.CleanName;
                        var displayName = podName.Length > 11 ? podName[..11] : podName;
                        var ip = profile.Networks.FirstOrDefault(n => n.NetworkId == b.Id || n.NetworkName == b.Name)?.IPAddress ?? "";

                        <!-- Connecting Line to Bridge -->
                        <line x1="400" y1="120" x2="@nx" y2="@ny"
                              stroke="@(isDangerous ? "#EF4444" : "#10B981")"
                              stroke-width="2"
                              stroke-dasharray="@(isDangerous ? "4,4" : "none")" />

                        <!-- Container Pod Node (Tactical Badge) -->
                        <g transform="translate(@nx, @ny)">
                            <rect x="-46" y="-18" width="92" height="36" rx="8" ry="8"
                                  fill="#0F172A" stroke="@(isDangerous ? "#EF4444" : "#10B981")" stroke-width="2" />
                            <text x="0" y="-3" text-anchor="middle" fill="#FFFFFF" font-weight="600" font-size="9" font-family="'JetBrains Mono', monospace">
                                @displayName
                            </text>
                            <text x="0" y="11" text-anchor="middle" fill="#94A3B8" font-size="8" font-family="'JetBrains Mono', monospace">
                                @(string.IsNullOrEmpty(ip) ? "dynamic" : ip)
                            </text>
                        </g>
                    }
                </svg>
            </div>
        </div>

        <!-- 2D Inter-Container Traffic Matrix -->
        <div class="soc-card mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="soc-heading m-0">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="3" y1="9" x2="21" y2="9"></line>
                        <line x1="9" y1="21" x2="9" y2="9"></line>
                    </svg>
                    2D Inter-Container Communication Matrix (Source ↓ to Destination →)
                </div>
                <span class="text-secondary small">Click on any alert cell to enforce netfilter drop rules</span>
            </div>



            @if (attachedProfiles.Count == 0)
            {
                <div class="text-muted text-center py-4 small">No containers attached to this bridge network.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="matrix-table">
                        <thead>
                            <tr>
                                <th class="text-start" style="width: 180px;">Source \ Target</th>
                                @foreach (var target in attachedProfiles)
                                {
                                    <th class="text-center font-mono">
                                        <div class="text-white font-weight-bold">@target.CleanName</div>
                                        <div class="text-muted small">@target.Networks.FirstOrDefault(n => n.NetworkName == b.Name)?.IPAddress</div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var source in attachedProfiles)
                            {
                                <tr>
                                    <td class="text-start font-mono">
                                        <div class="text-white font-weight-bold">@source.CleanName</div>
                                        <div class="text-muted small">Risk: @source.RiskScore/100</div>
                                    </td>

                                    @foreach (var target in attachedProfiles)
                                    {
                                        if (source.Id == target.Id)
                                        {
                                            <td class="matrix-cell matrix-cell-self font-mono">
                                                SELF
                                            </td>
                                        }
                                        else
                                        {
                                            var breach = b.Breaches.FirstOrDefault(br => br.SourceContainer == source.CleanName && br.TargetContainer == target.CleanName);
                                            var conn = b.InterContainerMatrix.FirstOrDefault(m => m.SourceContainerId == source.Id && m.TargetContainerId == target.Id);

                                            if (breach != null || conn?.HasPrivilegeAsymmetry == true)
                                            {
                                                <td class="matrix-cell matrix-cell-breach font-mono"
                                                    title="@(breach?.Detail ?? "Privilege Asymmetry Flow")"
                                                    @onclick="@(() => OpenRemediationModal(source.Id, source.CleanName, "apply_iptables_drop", "Enforce Netfilter Drop Rule", $"Block intra-bridge breach: {source.CleanName} -> {target.CleanName}", $"iptables -I DOCKER-USER -s {conn?.SourceIP} -d {conn?.TargetIP} -j DROP"))">
                                                    <div>⚠ BREACH</div>
                                                    <div style="font-size: 0.65rem;">Privilege Leak</div>
                                                </td>
                                            }
                                            else if (b.EnableIcc)
                                            {
                                                <td class="matrix-cell matrix-cell-unsegmented font-mono">
                                                    <div>ALLOWED</div>
                                                    <div style="font-size: 0.65rem;">Unsegmented ICC</div>
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="matrix-cell matrix-cell-isolated font-mono">
                                                    <div>ISOLATED</div>
                                                    <div style="font-size: 0.65rem;">ICC Blocked</div>
                                                </td>
                                            }
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<!-- Remediation Modal -->
<RemediationModal @bind-IsOpen="ShowModal"
                  ContainerId="@SelectedContainerId"
                  ContainerName="@SelectedContainerName"
                  ActionType="@SelectedActionType"
                  ActionTitle="@SelectedActionTitle"
                  Reason="@SelectedReason"
                  CustomRule="@SelectedCustomRule" />

@code {
    private BridgeNetworkAudit? SelectedBridge { get; set; }
    private bool ShowModal { get; set; }
    private string SelectedContainerId { get; set; } = string.Empty;
    private string SelectedContainerName { get; set; } = string.Empty;
    private string SelectedActionType { get; set; } = "apply_iptables_drop";
    private string SelectedActionTitle { get; set; } = "Enforce Netfilter Drop Rule";
    private string SelectedReason { get; set; } = string.Empty;
    private string SelectedCustomRule { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateUpdated;
        UpdateSelectedBridge();
    }

    private void OnStateUpdated()
    {
        UpdateSelectedBridge();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateSelectedBridge()
    {
        if (SelectedBridge == null && State.BridgeAudits.Count > 0)
        {
            SelectedBridge = State.BridgeAudits.FirstOrDefault(b => b.Name == "bridge") ?? State.BridgeAudits.First();
        }
        else if (SelectedBridge != null)
        {
            var refreshed = State.BridgeAudits.FirstOrDefault(b => b.Id == SelectedBridge.Id);
            if (refreshed != null) SelectedBridge = refreshed;
        }
    }

    public void Dispose()
    {
        State.OnChange -= OnStateUpdated;
    }

    private void SelectBridge(string id)
    {
        SelectedBridge = State.BridgeAudits.FirstOrDefault(b => b.Id == id);
    }

    private void OpenRemediationModal(string id, string name, string action, string title, string reason, string rule)
    {
        SelectedContainerId = id;
        SelectedContainerName = name;
        SelectedActionType = action;
        SelectedActionTitle = title;
        SelectedReason = reason;
        SelectedCustomRule = rule;
        ShowModal = true;
    }
}
